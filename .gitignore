# macOS
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Ferramentas de agente
.claude/

# Nada de segredo deve entrar aqui — estes scripts leem envs do projeto,
# nunca os armazenam. As linhas abaixo são rede de segurança.
.env
.env.*
*.key
*.pem
keys.txt

# Exceção: o template do gerador precisa versionar o .example (sem valores).
# Sem isto o deploy-project-scaffold nasce quebrado em qualquer clone.
!template/deploy-project/.env.dev.example
!infra/.env.dev.example
