#!/usr/bin/env bash
set -uo pipefail

################################################################################
# deploy-audit — audita os projetos deploy.* procurando os mesmos problemas
#                encontrados numa auditoria real de infraestrutura.
#
# Só LÊ. Não altera nada, não conecta em servidor nenhum.
#
# Uso:  ./deploy-audit [DIRETORIO_RAIZ_DOS_PROJETOS]
#       (padrão: $DEPLOY_PROJECTS_ROOT, ou o diretório atual)
################################################################################

case "${1:-}" in
  -h|--help) sed -n '5,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

ROOT="${1:-${DEPLOY_PROJECTS_ROOT:-$PWD}}"

if [[ ! -d "$ROOT" ]]; then
  echo "Diretório não encontrado: $ROOT" >&2
  echo "Uso: $(basename "$0") [DIRETORIO_RAIZ_DOS_PROJETOS]" >&2
  exit 1
fi

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'

total_projects=0
declare -a CRIT=() WARN=()

check_project() {
  local dir="$1" name; name="$(basename "$dir")"
  local findings=0
  local out=""

  add_crit() { out+="    ${RED}🔴 $1${NC}\n"; CRIT+=("${name}: $1"); findings=$((findings+1)); }
  add_warn() { out+="    ${YELLOW}🟠 $1${NC}\n"; WARN+=("${name}: $1"); findings=$((findings+1)); }

  # ── 1. Envs em texto puro versionados ────────────────────────────────────
  if [[ -d "$dir/.git" ]]; then
    local tracked
    tracked="$(cd "$dir" && git ls-files 2>/dev/null | grep -E '(^|/)\.env' || true)"
    if [[ -n "$tracked" ]]; then
      local plain=0 f
      while IFS= read -r f; do
        [[ -f "$dir/$f" ]] || continue
        grep -q '^sops_version=' "$dir/$f" 2>/dev/null && continue
        grep -qE '^[A-Z0-9_]*(PASSWORD|SECRET|TOKEN|_KEY|SALT|DSN)[A-Z0-9_]*=.{6,}' "$dir/$f" 2>/dev/null \
          && plain=$((plain+1))
      done <<< "$tracked"
      [[ "$plain" -gt 0 ]] && add_crit "${plain} env(s) com segredo em TEXTO PURO no git"
    fi
  fi

  # ── 2. Segredos assados na imagem ────────────────────────────────────────
  local baked
  baked="$(grep -rlE '^[[:space:]]*RUN.*(cp|mv).*\.env' "$dir"/.docker/Code/*/Dockerfile 2>/dev/null \
            | while read -r df; do
                grep -E '^[[:space:]]*RUN.*(cp|mv).*\.env' "$df" \
                  | grep -qvE '\.env\.build' && echo "$df"
              done | wc -l | tr -d ' ')"
  [[ "$baked" -gt 0 ]] && add_crit "${baked} Dockerfile(s) copiam .env para dentro da imagem"

  # ── 3. Portas de banco/cache publicadas em 0.0.0.0 ───────────────────────
  local compose exposed
  for compose in "$dir"/docker-compose.prd.yml "$dir"/docker-compose.prod.yml; do
    [[ -f "$compose" ]] || continue
    exposed="$(grep -oE '^[[:space:]]+-[[:space:]]*"?[0-9]{2,5}:(3306|5432|6379|27017|9200|7700|11211)"?[[:space:]]*$' "$compose" 2>/dev/null | tr -d ' "-' || true)"
    [[ -n "$exposed" ]] && add_crit "porta(s) de dado publicadas em 0.0.0.0: $(echo "$exposed" | tr '\n' ' ')"
    grep -qE '^[[:space:]]+-[[:space:]]*"?8080:8080"?' "$compose" 2>/dev/null \
      && grep -q 'api.insecure=true' "$compose" 2>/dev/null \
      && add_crit "dashboard do Traefik exposto sem autenticação (8080 + api.insecure)"
  done

  # ── 4. .dockerignore com o bug de profundidade ───────────────────────────
  if [[ -f "$dir/.dockerignore" ]]; then
    grep -qE '^\*\*/\.env' "$dir/.dockerignore" 2>/dev/null \
      || add_warn ".dockerignore não tem '**/.env*' (padrão sem **/ só protege a raiz)"
    grep -qE '^\*\*/\.git' "$dir/.dockerignore" 2>/dev/null \
      || add_warn ".dockerignore não tem '**/.git' (app/.git entra na imagem com o histórico)"
  else
    [[ -d "$dir/.docker" ]] && add_warn "sem .dockerignore"
  fi

  # ── 5. Tag móvel em produção ─────────────────────────────────────────────
  for compose in "$dir"/docker-compose.prd.yml "$dir"/docker-compose.prod.yml; do
    [[ -f "$compose" ]] || continue
    local n; n="$(grep -E '^[[:space:]]+image:.*:latest' "$compose" 2>/dev/null | wc -l | tr -d ' ')"
    [[ "$n" -gt 0 ]] && add_warn "${n} serviço(s) usando tag :latest (sem rollback nem versão conhecida)"
  done

  # ── 6. chmod 777 ─────────────────────────────────────────────────────────
  grep -rqE 'chmod -R 777' "$dir"/.docker 2>/dev/null && add_warn "chmod -R 777 em entrypoint/Dockerfile"

  # ── 7. Chaves privadas versionadas ───────────────────────────────────────
  if [[ -d "$dir/code" ]]; then
    local keys; keys=0
    local sub
    for sub in "$dir"/code/*/; do
      [[ -d "$sub/.git" ]] || continue
      # `grep -c` sai com 1 quando não acha nada; `wc -l` sempre sai 0.
      local n
      n="$( (cd "$sub" && git ls-files 2>/dev/null | grep -E '(oauth-private\.key|\.pem$|id_rsa$)' | wc -l) 2>/dev/null | tr -d ' ')"
      keys=$(( keys + ${n:-0} ))
    done
    [[ "$keys" -gt 0 ]] && add_crit "${keys} chave(s) privada(s) versionada(s) nos repos de código"
  fi

  # ── 8. SOPS já adotado? ──────────────────────────────────────────────────
  [[ -f "$dir/.sops.yaml" ]] && out+="    ${GREEN}✅ .sops.yaml presente${NC}\n"

  total_projects=$((total_projects+1))
  if [[ "$findings" -eq 0 ]]; then
    printf "  ${GREEN}✅ %-42s sem achados${NC}\n" "$name"
  else
    printf "  ${BOLD}%-42s %s achado(s)${NC}\n" "$name" "$findings"
    printf "%b" "$out"
  fi
}

echo
echo -e "${BLUE}${BOLD}Auditoria dos projetos deploy.*${NC}"
echo -e "${BLUE}Raiz: ${ROOT}${NC}"
echo

shopt -s nullglob
for d in "$ROOT"/*/deploy.*/; do
  [[ -d "$d" ]] || continue
  check_project "${d%/}"
done
shopt -u nullglob

echo
echo -e "${BOLD}─── Resumo ───${NC}"
echo "  Projetos auditados: ${total_projects}"
echo -e "  ${RED}Críticos:${NC} ${#CRIT[@]}    ${YELLOW}Atenção:${NC} ${#WARN[@]}"
echo
if [[ ${#CRIT[@]} -gt 0 ]]; then
  echo -e "${RED}${BOLD}Críticos — tratar primeiro:${NC}"
  printf '  • %s\n' "${CRIT[@]}"
  echo
fi
echo "Correções: docs/secrets-management.md §8, docs/deploy-pipeline.md §7,"
echo "           docs/secrets-rotation.md §7 (na documentação do projeto)."
echo
