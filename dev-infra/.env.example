# Infra de desenvolvimento — copie para .env e preencha.
# Este arquivo é um template: os valores sensíveis nascem VAZIOS de propósito.
# Cada dev usa as próprias senhas locais; nada aqui é compartilhado.

# ─── Credenciais locais (invente as suas) ────────────────────────────────────
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# ─── Portas no host ──────────────────────────────────────────────────────────
# A 80 é a única publicada em 0.0.0.0 — as demais ficam no loopback.
# Troque se algo já ocupa a porta na sua máquina.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ─── Ajustes ─────────────────────────────────────────────────────────────────
TZ=UTC
MYSQL_BUFFER_POOL=256M
REDIS_MAXMEMORY=256mb

# Arquitetura das imagens de terceiros.
#
# ⚠️ O padrão é linux/amd64 DE PROPÓSITO, mesmo em Apple Silicon: imagens de
#    terceiros já deram problemas difíceis de diagnosticar em arm64, e perder
#    desempenho é melhor do que perder dias procurando onde o erro mora.
#    Só mude se souber o que está fazendo — e reverta ao primeiro sintoma estranho.
INFRA_PLATFORM=linux/amd64
