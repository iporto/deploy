#!/usr/bin/env bash
set -uo pipefail

################################################################################
# deploy-scaffold-project — cria o repo deploy.<projeto> de um SaaS do kit
#
# Gera o AMBIENTE DE DESENVOLVIMENTO (docker-compose.dev.yml + nginx + php +
# hosts + envs) e o runbook de produção. Produção é Coolify: por isso NÃO gera
# docker-compose.prd.yml, servers.yml nem Watchtower — a esteira de deploy do
# aparato antigo não participa desta trilha.
#
# Os artefatos de build (Dockerfile, .deploy/, workflow) NÃO ficam aqui: vivem
# em cada repo de app, instalados pelo deploy-scaffold-app.
#
# Dry-run por padrão — exige --apply para escrever.
#
# Uso:  ./deploy-scaffold-project <dominio> [OPÇÕES]
#   <dominio>        domínio de produção. ex.: meuprojeto.com
#   --slug S         identificador curto      (padrão: 1º rótulo do domínio)
#   --dev-domain D   domínio de dev           (padrão: <slug>.io)
#   --ip IP          IP para o arquivo hosts  (padrão: 127.0.0.1 — Docker local)
#   --apps LISTA     api,platform | api,platform,www   (padrão: api,platform)
#   --dir DIR        onde criar               (padrão: ./deploy.<dominio>)
#   --from-kit DIR   instancia os apps a partir de um checkout do kit
#   --db-env FILE    aplica as credenciais geradas pelo `deploy-infra createdb`
#   --adopt          aceita um diretório que JÁ existe: cria só o que falta e
#                    nunca sobrescreve. Use quando você já tem code/ com os seus
#                    apps e quer só a base de Docker montada em volta.
#   --apply          escreve de fato
################################################################################

case "${1:-}" in
  -h|--help|'') sed -n '5,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'

DOMAIN="$1"; shift
SLUG=""; DEVDOMAIN=""; # Docker local é o caso comum: o projeto responde no loopback. Quem roda o
# daemon numa VM passa --ip com o endereço dela.
DEVIP="127.0.0.1"; APPS="api,platform"; DIR=""; APPLY=false
KIT=""; DB_ENV=""; ADOPT=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug)       SLUG="$2"; shift 2 ;;
    --dev-domain) DEVDOMAIN="$2"; shift 2 ;;
    --ip)         DEVIP="$2"; shift 2 ;;
    --apps)       APPS="$2"; shift 2 ;;
    --dir)        DIR="$2"; shift 2 ;;
    --from-kit)   KIT="$2"; shift 2 ;;
    --db-env)     DB_ENV="$2"; shift 2 ;;
    --adopt)      ADOPT=true; shift ;;
    --apply)      APPLY=true; shift ;;
    *) echo "Opção desconhecida: $1" >&2; exit 2 ;;
  esac
done

SLUG="${SLUG:-${DOMAIN%%.*}}"
# TLD de dev: .test é reservado pela RFC 6761 — nunca será domínio real, e não
# está na lista HSTS preload (foi isso que inviabilizou o .dev).
DEVDOMAIN="${DEVDOMAIN:-${SLUG}.test}"
DIR="${DIR:-./deploy.${DOMAIN}}"
# Um compose só: o env-www vive no profile "www" e fica inerte até ser pedido.
COMPOSE="docker-compose.dev.yml"
case "$APPS" in
  api,platform)     WWW=false ;;
  api,platform,www) WWW=true ;;
  *) echo "${RED}--apps aceita 'api,platform' ou 'api,platform,www'${NC}" >&2; exit 2 ;;
esac

_scripts_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local d; d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="${d}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}
LIB="$(_scripts_dir)"; TPL="${LIB}/template/deploy-project"
[[ -d "$TPL" ]] || { echo "${RED}Template não encontrado: ${TPL}${NC}" >&2; exit 1; }
if [[ -n "$KIT" ]]; then
  [[ -d "$KIT/code/api" && -d "$KIT/code/platform" ]] || {
    echo "${RED}Não parece um checkout do kit: ${KIT}${NC}" >&2
    echo "Esperava encontrar code/api e code/platform." >&2; exit 1; }
fi
[[ -z "$DB_ENV" || -f "$DB_ENV" ]] || { echo "${RED}--db-env: arquivo não encontrado: ${DB_ENV}${NC}" >&2; exit 1; }

echo "${BOLD}Projeto${NC}        ${DOMAIN}   (slug: ${SLUG})"
echo "${BOLD}Dev${NC}            ${DEVDOMAIN}   → ${DEVIP}"
echo "${BOLD}Apps${NC}           ${APPS}"
echo "${BOLD}Destino${NC}        ${DIR}"
echo
$APPLY || echo "${YELLOW}${BOLD}DRY-RUN${NC} — nada será escrito. Use --apply.${NC}"

# Abortar num diretório que já existe é o padrão certo: o caso comum é criar um
# projeto novo, e sobrescrever silenciosamente o trabalho de alguém é pior do que
# recusar. --adopt é a saída explícita para o outro caso — "eu JÁ tenho o code/
# com os meus apps, monte a base do Docker em volta" — e nele nada é sobrescrito:
# arquivo que já existe é preservado e reportado.
if [[ -e "$DIR" ]] && $APPLY && ! $ADOPT; then
  {
    echo "${RED}${DIR} já existe — abortando para não sobrescrever.${NC}"
    echo "Se a intenção é acrescentar a base de deploy a um projeto que já existe:"
    echo "    $(basename "$0") ${DOMAIN} --dir ${DIR} --adopt --apply"
  } >&2
  exit 1
fi

# ⚠️ O destino padrão é relativo ao diretório atual. Quem roda o comando de dentro
#    do clone da biblioteca acaba com o projeto ali dentro — funciona, mas mistura
#    o produto com a ferramenta, e o `git status` da biblioteca passa a acusá-lo.
_abs_dir="$(cd "$(dirname "$DIR")" 2>/dev/null && pwd)/$(basename "$DIR")"
case "$_abs_dir" in
  "${LIB}"/*)
    echo "${YELLOW}⚠️  O destino fica DENTRO do clone da biblioteca:${NC}"
    echo "     ${_abs_dir}"
    echo "   O projeto é seu, a biblioteca é ferramenta — convém separá-los."
    echo "   Rode de outro diretório, ou passe --dir com o caminho desejado."
    echo
    ;;
esac

_render() { sed -e "s/__DOMAIN__/${DOMAIN}/g" -e "s/__DEVDOMAIN__/${DEVDOMAIN}/g" \
                -e "s/__PROJECT__/${SLUG}/g"  -e "s/__DEVIP__/${DEVIP}/g" "$1"; }

# origem|destino
FILES=(
  "docker-compose.dev.yml|docker-compose.dev.yml"
  ".env.dev.example|.env.dev.example"
  ".gitignore|.gitignore"
  ".rsyncignore|.rsyncignore"
  "hosts|hosts"
  "docs/coolify-deploy.md|docs/coolify-deploy.md"
  ".docker/Nginx/conf/nginx.conf|.docker/Nginx/conf/nginx.conf"
  ".docker/Nginx/nginx-docker-proxy.conf|.docker/Nginx/nginx-docker-proxy.conf"
  ".docker/Nginx/conf/sites-enabled/_default.conf|.docker/Nginx/conf/sites-enabled/_default.conf"
  ".docker/Nginx/conf/sites-enabled/api.conf|.docker/Nginx/conf/sites-enabled/api.conf"
  ".docker/Nginx/conf/sites-enabled/platform.conf|.docker/Nginx/conf/sites-enabled/platform.conf"
  ".docker/Php/conf/php-ini/php.ini|.docker/Php/conf/php-ini/php.ini"
  ".docker/Php/conf.d/php-fpm.conf|.docker/Php/conf.d/php-fpm.conf"
  ".docker/Php/conf/sites-enabled/zz-docker.conf|.docker/Php/conf/sites-enabled/zz-docker.conf"
  # O serviço php-console monta estes três. Sem eles o Docker cria diretórios
  # vazios no lugar dos arquivos, e o container morre com "not a directory".
  ".docker/Console/init.sh|.docker/Console/init.sh"
  ".docker/Console/cron.d/crontab|.docker/Console/cron.d/crontab"
  ".docker/Console/conf.d/supervisord.conf|.docker/Console/conf.d/supervisord.conf"
  # Só o config do SSH. A chave privada NUNCA entra no template: o diretório é
  # montado no container, e cada projeto põe a própria chave se precisar.
  ".docker/Ssh/config|.docker/Ssh/config"
)
$WWW && FILES+=(".docker/Nginx/conf/sites-enabled/www.conf|.docker/Nginx/conf/sites-enabled/www.conf")

PRESERVADOS=0
for pair in "${FILES[@]}"; do
  src="${pair%%|*}"; dst="${pair#*|}"
  [[ -f "$TPL/$src" ]] || { echo "  ${RED}!${NC} ausente no template: $src"; continue; }
  # ⚠️ Em --adopt, arquivo existente é do usuário: pode ter sido ajustado à mão.
  #    Sobrescrever aqui apagaria o ajuste sem avisar.
  if $ADOPT && [[ -f "$DIR/$dst" ]]; then
    echo "  ${BLUE}=${NC} ${dst}   (já existia — preservado)"
    PRESERVADOS=$(( PRESERVADOS + 1 )); continue
  fi
  echo "  ${GREEN}+${NC} ${dst}"
  $APPLY || continue
  mkdir -p "$DIR/$(dirname "$dst")" && _render "$TPL/$src" > "$DIR/$dst"
done
if $ADOPT && [[ -f "$DIR/.env.dev" ]]; then
  echo "  ${BLUE}=${NC} .env.dev            (já existia — preservado)"
else
  echo "  ${GREEN}+${NC} .env.dev            (cópia local do .example, gitignored)"
fi
if $ADOPT && [[ -d "$DIR/code" ]] && [[ -n "$(ls -A "$DIR/code" 2>/dev/null)" ]]; then
  echo "  ${BLUE}=${NC} code/               (intocado — $(ls -d "$DIR/code"/*/ 2>/dev/null | wc -l | tr -d ' ') app(s) seus)"
else
  echo "  ${GREEN}+${NC} code/               (checkouts dos repos de app)"
fi

################################################################################
# Instanciar o kit como produto
#
# O kit entrega code/api e code/platform genéricos. Aqui eles viram os apps deste
# produto: renomeados pelo domínio, e com os envs apontando para a infra local.
################################################################################
_instanciar_kit() {
  local app dst
  for app in $(echo "$APPS" | tr ',' ' '); do
    [[ -d "$KIT/code/$app" ]] || { echo "  ${YELLOW}!${NC} kit não tem code/${app} — pulando"; continue; }
    dst="$DIR/code/${app}.${DOMAIN}"
    echo "  ${GREEN}+${NC} code/${app}.${DOMAIN}"
    $APPLY || continue

    # ⚠️ As exclusões não são conveniência: um .env do checkout do kit carrega
    #    credenciais de quem o clonou. A verificação depois da cópia existe
    #    porque uma exclusão silenciosamente errada vazaria segredo em cada
    #    produto gerado — e ninguém perceberia.
    mkdir -p "$dst"
    # ⚠️ A ORDEM das regras importa: o rsync aplica a PRIMEIRA que casa. O
    #    --include do .env.example precisa vir ANTES do --exclude '.env.*',
    #    senão o template do app não é copiado e o app nasce sem env nenhum.
    rsync -a --quiet \
      --include '.env.example' \
      --exclude '.env' --exclude '.env.*' \
      --exclude '.git/' --exclude '.github/' \
      --exclude 'vendor/' --exclude 'node_modules/' \
      --exclude 'mutagen.yml' --exclude 'mutagen.yml.lock' \
      "$KIT/code/$app/" "$dst/" 2>/dev/null || { print_falha "rsync de $app"; return 1; }

    if find "$dst" -name '.env' -o -name '.env.local' | grep -q .; then
      echo "${RED}ABORTADO: um .env foi copiado do kit para ${dst}.${NC}" >&2
      echo "Isso levaria credenciais de outra pessoa para dentro deste produto." >&2
      return 1
    fi
    _reescrever_env "$dst" "$app"
  done
}

# ⚠️ sed -i não é portátil. O BSD (macOS) exige argumento de sufixo — `sed -i ''`
#    — e o GNU (Linux) trata esse '' como NOME DE ARQUIVO, falhando com
#    "can't read : No such file or directory". A biblioteca roda nos dois.
if sed --version >/dev/null 2>&1; then
  _sed_i() { sed -i "$@"; }          # GNU
else
  _sed_i() { sed -i '' "$@"; }       # BSD / macOS
fi

# Aponta o .env.example do app para a infra local e para este produto.
_reescrever_env() {
  local dst="$1" app="$2" f="$1/.env.example"
  [[ -f "$f" ]] || return 0
  local titulo; titulo="$(echo "${SLUG:0:1}" | tr '[:lower:]' '[:upper:]')${SLUG:1}"
  # DB_HOST=127.0.0.1 é a armadilha silenciosa: dentro do container isso é o
  # PRÓPRIO container, não o MySQL. E o init-laravel.sh copia este arquivo para
  # .env sozinho, então o app subiria apontando para o lugar errado sem avisar.
  _sed_i \
    -e "s|^DB_HOST=.*|DB_HOST=infra-mysql|" \
    -e "s|^REDIS_HOST=.*|REDIS_HOST=infra-redis|" \
    -e "s|^MAIL_HOST=.*|MAIL_HOST=infra-mail|" \
    -e "s|^DB_DATABASE=.*|DB_DATABASE=${SLUG}|" \
    -e "s|^APP_URL=.*|APP_URL=http://${app}.${DEVDOMAIN}|" \
    -e "s|^APP_PLATFORM_URL=.*|APP_PLATFORM_URL=http://platform.${DEVDOMAIN}|" \
    -e "s|^APP_NAME=.*|APP_NAME=\"${titulo} $(echo "${app:0:1}" | tr '[:lower:]' '[:upper:]')${app:1}\"|" \
    -e "s|^VITE_URL=.*|VITE_URL=http://${app}.${DEVDOMAIN}|" \
    -e "s|^VITE_HMR_HOST=.*|VITE_HMR_HOST=${app}.${DEVDOMAIN}|" \
    "$f"
  # Credenciais do createdb, quando fornecidas.
  if [[ -n "$DB_ENV" ]]; then
    local k v
    # ⚠️ Só aceita linhas KEY=VALOR. Um arquivo de credenciais poluído — por uma
    #    mensagem que escapou para o stdout de quem o gerou — produziria uma
    #    expressão sed inválida, e o erro não diria de onde veio.
    while IFS='=' read -r k v; do
      [[ "$k" =~ ^[A-Z][A-Z0-9_]*$ ]] || continue
      _sed_i "s|^${k}=.*|${k}=${v}|" "$f"
    done < "$DB_ENV"
  fi
}
print_falha() { echo "${RED}Falha: $*${NC}" >&2; }

# Um projeto completo é uma ÁRVORE de repositórios: o deploy é um, e cada app é
# outro. Não é preciosismo — a trilha de produção constrói a imagem a partir do
# repositório DO APP (push → GHA → GHCR → Coolify). Sem um repo por app não há
# build.
#
# ⚠️ O `git init` aqui existe para evitar o pior silêncio possível: o .gitignore
#    deste projeto tem `/code/*`, então quem commitasse só o deploy acharia que
#    levou o código junto. O colega clonaria e receberia um code/ vazio, sem
#    nenhum erro. Nascendo cada app como repositório, o engano não acontece.
_iniciar_repos() {
  command -v git >/dev/null 2>&1 || { echo "  ${YELLOW}!${NC} git não encontrado — repositórios não iniciados"; return 0; }
  local d nome
  for d in "$DIR" "$DIR/code"/*/; do
    d="${d%/}"; [[ -d "$d" ]] || continue
    nome="$(basename "$d")"
    if [[ -d "$d/.git" ]]; then
      echo "  ${DIM}=${NC} ${nome} — já era um repositório"
      continue
    fi
    (
      cd "$d" || exit 1
      git init -q || exit 1
      # `git init -b main` exige git 2.28+. Isto funciona em qualquer versão e
      # só vale porque ainda não há commit nenhum.
      git symbolic-ref HEAD refs/heads/main 2>/dev/null || true
      git add -A || exit 1
      git commit -q -m "chore: ponto de partida gerado pelo starter kit" || exit 1
    ) && echo "  ${GREEN}+${NC} ${nome} — repositório iniciado (branch main)" \
      || echo "  ${YELLOW}!${NC} ${nome} — git init falhou (configure user.name/user.email)"
  done
}

# Runbook do SEGUNDO momento: alguém que pega o projeto andando. Gerado com os
# nomes reais porque um passo a passo genérico obriga a traduzir cada linha, e é
# aí que se erra.
_escrever_onboarding() {
  local f="$DIR/docs/onboarding.md" app
  # Em --adopt o runbook pode ter sido editado com as URLs reais dos repos —
  # que é justamente o que o scaffold não tem como saber. Reescrever apagaria.
  if $ADOPT && [[ -f "$f" ]]; then
    echo "  ${BLUE}=${NC} docs/onboarding.md   (já existia — preservado)"
    return 0
  fi
  mkdir -p "$DIR/docs"
  {
    echo "# Entrar neste projeto"
    echo
    echo "> Para quem **pega o projeto andando**. Se você é quem gerou o projeto,"
    echo "> o caminho é o README do kit."
    echo
    echo "Este produto são **$(( $(ls -d "$DIR/code"/*/ 2>/dev/null | wc -l | tr -d ' ') + 1 )) repositórios**: este, com a infraestrutura, e um por app."
    echo "O \`.gitignore\` daqui ignora \`/code/*\` de propósito — os apps não moram"
    echo "aqui dentro, cada um tem o seu repositório e constrói a própria imagem."
    echo
    echo '```'
    echo "deploy.${DOMAIN}/          ← este repositório (compose, nginx, envs, hosts)"
    echo "└── code/"
    local _ult; _ult="$(ls -d "$DIR/code"/*/ 2>/dev/null | tail -1)"
    for app in "$DIR/code"/*/; do
      [[ -d "$app" ]] || continue
      if [[ "$app" == "$_ult" ]]; then echo "    └── $(basename "$app")/   ← repositório próprio"
      else                             echo "    ├── $(basename "$app")/   ← repositório próprio"; fi
    done
    echo '```'
    echo
    echo "## 1. Clonar este repositório"
    echo
    echo '```bash'
    echo "git clone <url-deste-repo> deploy.${DOMAIN}"
    echo "cd deploy.${DOMAIN}"
    echo '```'
    echo
    echo "## 2. Clonar os apps dentro de \`code/\`"
    echo
    echo "Só os que você tem acesso — o ambiente sobe com um subconjunto."
    echo
    echo '```bash'
    echo "mkdir -p code"
    for app in "$DIR/code"/*/; do
      [[ -d "$app" ]] || continue
      echo "git clone <url> code/$(basename "$app")"
    done
    echo '```'
    echo
    echo "> ⚠️ **O nome do diretório importa.** O \`docker-compose.dev.yml\` monta"
    echo "> \`./code/<nome>\` por caminho. Clonar com outro nome sobe o container com"
    echo "> um diretório vazio dentro, e o erro fala de arquivo faltando, não de nome."
    echo
    echo "## 3. O env local"
    echo
    echo '```bash'
    echo "cp .env.dev.example .env.dev"
    echo '```'
    echo
    echo "Preencha as credenciais do banco. Elas não são as mesmas de quem gerou o"
    echo "projeto: cada máquina tem a sua infra local. Para criar um banco novo:"
    echo
    echo '```bash'
    echo "deploy-infra createdb ${SLUG}"
    echo '```'
    echo
    echo "## 4. Conferir e subir"
    echo
    echo '```bash'
    echo "deploy-doctor ."
    echo "./deploy-run dev"
    echo '```'
    echo
    echo "O \`deploy-doctor\` avisa se algum app ficou faltando em \`code/\` e se o"
    echo "\`/etc/hosts\` está resolvendo os domínios."
  } > "$f"
  echo "  ${GREEN}+${NC} docs/onboarding.md   (para quem entrar depois)"
}

[[ -n "$KIT" ]] && { echo; echo "${BOLD}Apps do kit${NC}"; _instanciar_kit || exit 1; }

if $APPLY; then
  if [[ ! -f "$DIR/.env.dev" ]]; then
    cp "$DIR/.env.dev.example" "$DIR/.env.dev"; chmod 600 "$DIR/.env.dev"
  fi
  mkdir -p "$DIR/code"
  # Só os dois verbos que a trilha Coolify usa. Os outros servem ao ciclo
  # :prd + Watchtower e não fazem nada aqui.
  "${LIB}/deploy-shim-install" "$DIR" --apply --all-verbs \
      --verbs deploy-run,deploy-sync >/dev/null 2>&1 \
    && echo "  ${GREEN}+${NC} verbos: deploy-run, deploy-sync" \
    || echo "  ${YELLOW}!${NC} falha ao instalar os verbos — rode deploy-shim-install à mão"

  # O TEMPLATE.md é o ponto de partida do segundo momento: com o ambiente no ar,
  # o dev duplica isto para desenhar o próprio produto.
  if [[ -n "$KIT" && -f "$KIT/docs/starter-kit-ideas/TEMPLATE.md" ]]; then
    mkdir -p "$DIR/docs"
    cp "$KIT/docs/starter-kit-ideas/TEMPLATE.md" "$DIR/docs/TEMPLATE.md"
    echo "  ${GREEN}+${NC} docs/TEMPLATE.md"
  fi

  # Artefatos de build nos apps copiados (Dockerfile, .deploy/, workflow).
  if [[ -n "$KIT" && -x "${LIB}/deploy-scaffold-app" ]]; then
    "${LIB}/deploy-scaffold-app" "$DIR/code" --apply >/dev/null 2>&1 \
      && echo "  ${GREEN}+${NC} artefatos de build nos apps" \
      || echo "  ${YELLOW}!${NC} rode deploy-scaffold-app ${DIR}/code --apply"
  fi

  _escrever_onboarding

  # Por último: o git init tem que enxergar tudo o que os passos acima criaram.
  echo
  echo "${BOLD}Árvore de repositórios${NC}"
  _iniciar_repos
  echo
  # ⚠️ Sob o assistente esta lista vira RUÍDO: ele conduz os mesmos passos logo
  # em seguida, com outra numeração. Duas listas "1..5" na mesma tela mandando
  # coisas diferentes é pior do que nenhuma.
  if [[ -n "${DEPLOY_WIZARD:-}" ]]; then
    echo "${GREEN}${BOLD}Pronto.${NC} Projeto gerado em ${DIR}"
    echo "  Para compartilhar depois: ${DIR}/docs/onboarding.md"
  else
    echo "${GREEN}${BOLD}Pronto.${NC} Próximos passos:"
    echo
    n=1
    if [[ -z "$KIT" ]]; then
      echo "  ${n}. clonar os apps em ${DIR}/code/ (api.${DOMAIN}, platform.${DOMAIN})"; n=$((n+1))
      echo "  ${n}. equipar os apps:  deploy-scaffold-app ${DIR}/code --apply"; n=$((n+1))
    fi
    if [[ -z "$DB_ENV" ]]; then
      echo "  ${n}. criar o banco:    deploy-infra createdb ${SLUG}"
      echo "     e colar as credenciais nos .env.example dos apps"; n=$((n+1))
    fi
    # ⚠️ Sem esta linha o navegador não erra: vai para a internet. Sintoma que não
    #    aponta para a causa — por isso é passo explícito, não nota de rodapé.
    echo "  ${n}. ${BOLD}editar o /etc/hosts${NC} — a máquina onde roda o NAVEGADOR:"; n=$((n+1))
    sed "s/^/       /" "${DIR}/hosts" 2>/dev/null | grep -v '^\s*#' | grep -v '^\s*$'
    echo "  ${n}. subir:            cd ${DIR} && ./deploy-run dev"; n=$((n+1))
    # ⚠️ `docker compose exec` não funciona aqui: o compose deste projeto chama-se
    #    docker-compose.dev.yml, que não é nome que o compose procura sozinho — e o
    #    working_dir do container é /var/www/html, não o diretório do app.
    echo "  ${n}. migrar:"; n=$((n+1))
    echo "       docker exec ${SLUG}-php-api sh -c 'cd api.${DOMAIN} && php artisan migrate --force'"
    echo "  ${n}. gerar o token de acesso:"; n=$((n+1))
    echo "       docker exec ${SLUG}-php-api sh -c 'cd api.${DOMAIN} && php artisan dev:token'"
    echo "  ${n}. entrar sem o SSO: use o link que o comando acima imprime"

    echo
    echo "  ${BOLD}Publicar os repositórios${NC} — um por caixa, quando for compartilhar:"
    echo "       cd ${DIR} && git remote add origin <url> && git push -u origin main"
    for _a in "$DIR/code"/*/; do
      [[ -d "$_a" ]] || continue
      echo "       cd ${DIR}/code/$(basename "$_a") && git remote add origin <url> && git push -u origin main"
    done
    echo "     Cada app constrói a própria imagem a partir do próprio repositório."
    echo "     Quem entrar no projeto depois segue ${DIR}/docs/onboarding.md."
    echo
    echo "  Depois disso: duplique docs/TEMPLATE.md e desenhe o produto."
    echo "  Produção: ${DIR}/docs/coolify-deploy.md"
  fi
else
  echo; echo "${YELLOW}Rode com --apply para escrever.${NC}"
fi
