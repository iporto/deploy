#!/usr/bin/env bash
set -uo pipefail

################################################################################
# deploy-shim-install — instala o shim de bootstrap em projetos deploy.*
#
# Troca os symlinks de caminho ABSOLUTO (que só resolvem na máquina de quem
# criou o projeto) por symlinks RELATIVOS para .deploy/bin/shim, versionado no
# próprio projeto. O shim descobre esta biblioteca em runtime.
#
# Idempotente: projeto já convertido é reportado e pulado.
# Dry-run por padrão — exige --apply para escrever.
#
# Uso:  ./deploy-shim-install [DIRETORIO] [--apply]
#       DIRETORIO pode ser a raiz dos projetos ou um projeto específico.
#       --all-verbs        cria também os verbos ausentes (projeto novo).
#       --verbs a,b,c      instala só esses verbos, em vez da lista completa.
#       (padrão: $DEPLOY_PROJECTS_ROOT, ou o diretório atual)
################################################################################

case "${1:-}" in
  -h|--help) sed -n '5,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'

APPLY=false
ALL_VERBS=false
VERBS_OVERRIDE=""
ROOT=""
_next_is_verbs=false
for arg in "$@"; do
  if $_next_is_verbs; then VERBS_OVERRIDE="$arg"; _next_is_verbs=false; continue; fi
  case "$arg" in
    --apply) APPLY=true ;;
    --all-verbs) ALL_VERBS=true ;;
    --verbs) _next_is_verbs=true ;;
    -*) echo "Opção desconhecida: $arg" >&2; exit 2 ;;
    *)  ROOT="$arg" ;;
  esac
done
ROOT="${ROOT:-${DEPLOY_PROJECTS_ROOT:-$PWD}}"

_scripts_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir; dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="${dir}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPTS_DIR="$(_scripts_dir)"
TEMPLATE="${SCRIPTS_DIR}/template/shim"

[[ -f "$TEMPLATE" ]] || { echo "${RED}Template não encontrado: ${TEMPLATE}${NC}" >&2; exit 1; }
[[ -d "$ROOT"     ]] || { echo "${RED}Diretório não encontrado: ${ROOT}${NC}" >&2; exit 1; }

# Verbos executáveis que passam pelo shim. deploy-readme.md é tratado à parte:
# é documentação, e não se executa um markdown.
VERBS=(deploy deploy-audit deploy-backup deploy-mutagen deploy-promote deploy-run
       deploy-sync deploy-token-check envedit harden-vm deploy-shim-install)

# --verbs restringe a lista. É o que a trilha Coolify usa: dos 10, só deploy-run
# e deploy-sync têm função lá — os outros servem ao ciclo :prd + Watchtower.
if [[ -n "$VERBS_OVERRIDE" ]]; then
  IFS=',' read -r -a VERBS <<< "$VERBS_OVERRIDE"
  for v in "${VERBS[@]}"; do
    [[ -f "${SCRIPTS_DIR:-$(_scripts_dir)}/${v}" ]] || {
      echo "${RED}Verbo desconhecido: ${v}${NC}" >&2; exit 2; }
  done
fi

# Descobre os projetos: um diretório específico, ou a varredura da raiz.
PROJECTS=()
# Reconhece os dois modelos: o aparato antigo (.env.prd/compose de produção) e a
# trilha Coolify, que só tem ambiente de dev — produção é o runbook do Coolify.
if [[ -e "${ROOT}/docker-compose.prd.yml" || -e "${ROOT}/.env.prd" || -e "${ROOT}/.deploy" \
   || -e "${ROOT}/docker-compose.dev.yml" || -e "${ROOT}/.env.dev" ]]; then
  PROJECTS=("$ROOT")
else
  while IFS= read -r d; do PROJECTS+=("$d"); done < <(
    find "$ROOT" -maxdepth 2 -type d -name 'deploy.*' 2>/dev/null | sort
  )
fi
# ⚠️ A mensagem antiga era "Nenhum projeto deploy.* encontrado" — dita a quem
#    estava PARADO DENTRO de um deploy.xyz.com. Ela descrevia o segundo modo de
#    uso (varrer filhos) para quem tentava o primeiro (equipar este diretório), e
#    mandava procurar o erro no lugar errado. Agora diz o que faltou e o que
#    fazer nos dois casos.
if [[ ${#PROJECTS[@]} -eq 0 ]]; then
  {
    # `${ROOT}.` com ROOT="." imprimia "em ..". Mostrar o caminho resolvido
    # também evita a dúvida de qual diretório o comando olhou.
    echo "${RED}Nada para instalar em: $(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")${NC}"
    echo
    echo "Este diretório não parece um projeto de deploy — não encontrei nenhum destes:"
    echo "  docker-compose.dev.yml · docker-compose.prd.yml · .env.dev · .env.prd · .deploy/"
    echo "E também não há subdiretório deploy.* aqui para instalar em lote."
    echo
    echo "${BOLD}Se o projeto ainda não existe${NC} — crie a estrutura primeiro:"
    echo "    deploy-scaffold-project <dominio> --dir . --apply"
    echo "  Gera compose, nginx, envs e hosts, e já instala os verbos."
    echo
    echo "${BOLD}Se você já tem o seu próprio docker-compose${NC} — o shim se ancora nele."
    echo "  Nomeie-o docker-compose.dev.yml (ou .prd.yml) e rode este comando de novo."
  } >&2
  exit 1
fi

$APPLY || echo "${YELLOW}${BOLD}DRY-RUN${NC} — nada será escrito. Use --apply para valer.${NC}"
echo

TOTAL=0; CONVERTED=0; SKIPPED=0; FAILED=0

for proj in ${PROJECTS[@]+"${PROJECTS[@]}"}; do
  TOTAL=$((TOTAL+1))
  name="$(basename "$proj")"
  actions=()

  # O que precisa mudar?
  need_shim=false
  [[ -f "${proj}/.deploy/bin/shim" ]] && \
    { cmp -s "$TEMPLATE" "${proj}/.deploy/bin/shim" || need_shim=true; } || need_shim=true

  # Converte o que já existe. Com --all-verbs, CRIA também os que faltam — é o
  # caso de projeto novo, onde não há symlink algum para converter.
  to_convert=()
  for v in "${VERBS[@]}"; do
    if [[ -L "${proj}/${v}" ]]; then
      tgt="$(readlink "${proj}/${v}")"
      [[ "$tgt" == ".deploy/bin/shim" ]] && continue
      to_convert+=("$v")
    elif $ALL_VERBS && [[ ! -e "${proj}/${v}" && "$v" != "deploy-shim-install" ]]; then
      to_convert+=("$v")
    fi
  done

  readme_pending=false
  [[ -L "${proj}/deploy-readme.md" ]] && readme_pending=true
  $ALL_VERBS && [[ ! -e "${proj}/deploy-readme.md" ]] && readme_pending=true

  rsync_pending=()
  if [[ -f "${proj}/.rsyncignore" ]]; then
    grep -qxF 'deploy-run' "${proj}/.rsyncignore" || rsync_pending+=("deploy-run")
    grep -qxF '.deploy/'   "${proj}/.rsyncignore" || rsync_pending+=(".deploy/")
  fi

  if ! $need_shim && [[ ${#to_convert[@]} -eq 0 ]] && ! $readme_pending && [[ ${#rsync_pending[@]} -eq 0 ]]; then
    printf '  %s✓%s %-46s já convertido\n' "$GREEN" "$NC" "$name"
    SKIPPED=$((SKIPPED+1)); continue
  fi

  $need_shim && actions+=("instala .deploy/bin/shim")
  [[ ${#to_convert[@]} -gt 0 ]] && actions+=("converte ${#to_convert[@]} verbo(s): ${to_convert[*]}")
  $readme_pending && actions+=("deploy-readme.md → ponteiro")
  [[ ${#rsync_pending[@]} -gt 0 ]] && actions+=(".rsyncignore += ${rsync_pending[*]}")

  printf '  %s→%s %-46s\n' "$BLUE" "$NC" "$name"
  printf '      • %s\n' "${actions[@]}"

  if ! $APPLY; then CONVERTED=$((CONVERTED+1)); continue; fi

  # ---------- aplicação ----------
  ok=true
  if $need_shim; then
    mkdir -p "${proj}/.deploy/bin" && cp "$TEMPLATE" "${proj}/.deploy/bin/shim" \
      && chmod 755 "${proj}/.deploy/bin/shim" || ok=false
  fi

  for v in ${to_convert[@]+"${to_convert[@]}"}; do
    rm -f "${proj}/${v}" && ln -s .deploy/bin/shim "${proj}/${v}" || ok=false
  done

  if $readme_pending; then
    rm -f "${proj}/deploy-readme.md"
    cat > "${proj}/deploy-readme.md" <<'DOC'
# Como este deploy funciona

Este documento **não vive neste repositório**. Ele descreve o modelo de deploy
compartilhado por todos os projetos `deploy.*` — os dois canais, os quatro
verbos, o caminho que um segredo percorre.

Leia a versão canônica em:

- Local, se você já tem a biblioteca instalada:
  `$DEPLOY_SCRIPTS_HOME/DEPLOY-README.md` (ou `~/.deploy-scripts/DEPLOY-README.md`)
- Remoto: <https://github.com/iporto/deploy/blob/main/DEPLOY-README.md>

Para a referência de cada comando e flag, veja o `README.md` do mesmo repositório.
DOC
    [[ -f "${proj}/deploy-readme.md" ]] || ok=false
  fi

  if [[ ${#rsync_pending[@]} -gt 0 ]]; then
    {
      echo ""
      echo "# ─── Shim de bootstrap ───────────────────────────────────────────────────────"
      echo "# Os verbos são symlinks relativos para .deploy/bin/shim e não servem na VM."
      echo "#"
      echo "# ⚠️ deploy-run PRECISA existir na VM, mas é entregue explicitamente por"
      echo "#    push_deploy_run() no deploy-sync — não mais pelo rsync -L, que agora"
      echo "#    copiaria o próprio shim."
      printf '%s\n' "${rsync_pending[@]}"
    } >> "${proj}/.rsyncignore" || ok=false
  fi

  if $ok; then
    printf '      %s✓ aplicado%s\n' "$GREEN" "$NC"; CONVERTED=$((CONVERTED+1))
  else
    printf '      %s✗ falhou%s\n' "$RED" "$NC"; FAILED=$((FAILED+1))
  fi
done

echo
echo "${BOLD}Projetos: ${TOTAL}${NC}  •  a converter/convertidos: ${CONVERTED}  •  já ok: ${SKIPPED}  •  falhas: ${FAILED}"
if $APPLY && [[ $CONVERTED -gt 0 ]]; then
  echo
  echo "${BOLD}Próximo passo${NC} — commite os verbos e o .deploy/bin/shim."
  echo "  São eles que fazem o repositório funcionar na máquina de outra pessoa."
fi
$APPLY || echo "${YELLOW}Rode de novo com --apply para escrever.${NC}"
[[ $FAILED -eq 0 ]]
