#!/usr/bin/env bash
set -euo pipefail

################################################################################
# ⚠️ ESTE SCRIPT PRECISA SER AUTOSSUFICIENTE — NÃO DÊ `source` EM NADA.
#
# Ele é o único da biblioteca que roda DENTRO da VM, e chega lá sozinho: o
# push_deploy_run() do deploy-sync copia este arquivo, e só ele, pela conexão
# SSH. Nenhuma outra parte da biblioteca existe no servidor.
#
# Portanto: as funções print_*, as cores e o _scripts_dir() estão duplicadas aqui
# de propósito. Extrair para um lib.sh compartilhado — tentador, porque a
# duplicação é real em 9 scripts — QUEBRA PRODUÇÃO: a lib não seria entregue, e
# o erro só apareceria no primeiro deploy depois da mudança.
#
# Se um dia a lib for extraída, o push_deploy_run() tem de entregá-la junto.
################################################################################

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

print_error()   { echo -e "${RED}[ERRO]${NC} $*" >&2; }
print_success() { echo -e "${GREEN}[OK]${NC} $*"; }
print_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
print_warning() { echo -e "${YELLOW}[AVISO]${NC} $*"; }

show_usage() {
  cat << EOF
Uso: $(basename "$0") [AMBIENTE] [COMANDO|SERVIÇO] [FLAGS]

MODO REMOTO (a partir do Mac):
  Com um ambiente como primeiro argumento, conecta no servidor e executa lá.
    ./deploy-run prd env-app     recria só o env-app no servidor de produção
    ./deploy-run prd             sobe/atualiza tudo no servidor de produção

MODO LOCAL (na VM), sem ambiente — comportamento original:

COMANDOS:
  (nenhum)          Sobe/atualiza todos os serviços
  status            Mostra o que está no ar neste projeto
  stop              Para todos os containers do projeto
  --fresh, -f       Remove volumes e recria tudo do zero

SERVIÇO:
  <nome>            Rebuilda apenas o serviço especificado (ex: api, worker)

FLAGS:
  --no-pull, -P     Não executa pull de imagens (usa cache local)
  --help,    -h     Exibe esta ajuda

EXEMPLOS:
  ./deploy-run                   Sobe todos os serviços
  ./deploy-run stop              Para todos os containers
  ./deploy-run --fresh           Destrói volumes e recria do zero
  ./deploy-run api               Rebuilda apenas o serviço 'api'
  ./deploy-run api --no-pull     Rebuilda 'api' sem pull

AMBIENTES (via APP_ENV no .env):
  development  →  docker-compose.dev.yml  →  projeto: <name>-dev
  staging      →  docker-compose.stg.yml  →  projeto: <name>-stg
  production   →  docker-compose.prd.yml  →  projeto: <name>-prod
               ↳  (fallback: docker-compose.prod.yml)

VARIÁVEIS OBRIGATÓRIAS NO .env:
  APP_ENV            Ambiente (development | staging | production)
  APP_PROJECT_NAME   Nome base do projeto Docker
  REGISTRY_HOST      Registry (ghcr.io | docker.io). Padrão: docker.io
  REGISTRY_USER      Usuário do registry  (fallback: DOCKER_USER)
  REGISTRY_TOKEN     Token do registry    (fallback: DOCKER_TOKEN)

EOF
}

# Pré-processa flags antes de carregar o .env
NO_PULL=false
NO_SYNC=false
POSITIONAL_ARGS=()

for arg in "$@"; do
  case "$arg" in
    --help|-h)    show_usage; exit 0 ;;
    --no-pull|-P) NO_PULL=true ;;
    --no-sync)    NO_SYNC=true ;;
    *)            POSITIONAL_ARGS+=("$arg") ;;
  esac
done

CMD="${POSITIONAL_ARGS[0]:-}"

# ─── O primeiro argumento como ambiente ──────────────────────────────────────
#
#   ./deploy-run             na VM: roda local lendo o .env entregue pelo sync
#   ./deploy-run dev         lê .env.dev e roda NO CONTEXTO DOCKER ATIVO
#   ./deploy-run prd env-app faz SSH e roda o deploy-run de dentro da VM
#
# ⚠️ `dev` e `prd` são deliberadamente diferentes.
#
#    dev usa o contexto: é o caso do desenvolvedor, que pode ter Docker local ou
#    apontado para uma VM. O contexto já sabe o destino — SSH aqui seria redundante.
#
#    prd NÃO usa o contexto: produção tem um host definido no .env.prd, não "o
#    contexto que por acaso está ativo". Sem isso, um `./deploy-run prd` com o
#    contexto apontando para a VM de desenvolvimento subiria o compose de
#    produção no lugar errado. O SSH aqui é proteção, não legado.
case "$CMD" in
  dev)
    ENV_TARGET="dev"
    ENV_FILE_LOCAL=".env.dev"
    if [[ ! -f "$ENV_FILE_LOCAL" ]]; then
      print_error "Arquivo .env.dev não encontrado — rode na raiz do projeto"
      exit 1
    fi
    # Tira o "dev" da frente: o resto do script vê os argumentos como sempre.
    POSITIONAL_ARGS=("${POSITIONAL_ARGS[@]:1}")
    CMD="${POSITIONAL_ARGS[0]:-}"
    ;;
  prd|stg)
    ENV_TARGET="$CMD"
    REMAINING=("${POSITIONAL_ARGS[@]:1}")
    [[ "$NO_PULL" == true ]] && REMAINING+=("--no-pull")

    ENV_FILE=".env.${ENV_TARGET}"
    if [[ ! -f "$ENV_FILE" ]]; then
      print_error "Arquivo $ENV_FILE não encontrado — rode na raiz do projeto"
      exit 1
    fi

    # REMOTE_HOST e REMOTE_BASE_PATH ficam em texto puro mesmo no env cifrado
    # (unencrypted_regex), justamente para poderem ser lidos sem SOPS.
    # O `|| true` é essencial: sem ele o grep que não encontra a chave retorna 1,
    # e o `set -e` mata o script DENTRO da substituição de comando — antes da
    # validação logo abaixo. O sintoma era sair em silêncio, com exit 0, num
    # .env.prd malformado. Falha silenciosa é pior que erro.
    _read() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true; }
    REMOTE_HOST="$(_read REMOTE_HOST)"
    REMOTE_BASE_PATH="$(_read REMOTE_BASE_PATH)"
    BASTION_HOST="$(_read BASTION_HOST)"

    if [[ -z "$REMOTE_HOST" || -z "$REMOTE_BASE_PATH" ]]; then
      print_error "REMOTE_HOST ou REMOTE_BASE_PATH ausentes em $ENV_FILE"
      exit 1
    fi

    SSH_CMD=(ssh -o ConnectTimeout=10)
    [[ -n "$BASTION_HOST" ]] && SSH_CMD+=(-J "$BASTION_HOST")

    print_info "Executando no servidor: ${REMOTE_HOST}"
    # Nem todo argumento restante é serviço: `status`, `stop` e `--fresh` são
    # comandos. Chamá-los de "Serviço(s)" descrevia errado o que ia acontecer.
    if [[ ${#REMAINING[@]} -gt 0 ]]; then
      case "${REMAINING[0]}" in
        status|stop|--fresh|-f) print_info "Comando: ${REMAINING[*]}" ;;
        *)                      print_info "Serviço(s): ${REMAINING[*]}" ;;
      esac
    fi

    # ${arr[*]} puro quebra com "unbound variable" no bash 3.2 (padrão do macOS)
    # quando o array está vazio — mesmo declarado (ex.: "./deploy-run dev" sem
    # serviço extra). Aqui é só interpolação de string, então ":-" basta.
    exec "${SSH_CMD[@]}" "$REMOTE_HOST" \
      "cd '${REMOTE_BASE_PATH}' && ./deploy-run ${REMAINING[*]:-}"
    ;;
esac

# Configurações Docker
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

case "$(uname -m)" in
  x86_64* | i*86) export DOCKER_DEFAULT_PLATFORM="linux/amd64" ;;
  arm*)           export DOCKER_DEFAULT_PLATFORM="linux/arm64" ;;
esac

# ─── Profiles extras ─────────────────────────────────────────────────────────
#
# O compose sobe com --profile $APP_ENV. Serviços opcionais (o env-www do kit,
# por exemplo) vivem em profiles próprios e ficam inertes até serem pedidos.
#
# Ativar é acrescentar o nome em COMPOSE_EXTRA_PROFILES no .env — sem editar o
# docker-compose.yml, o que preservaria qualquer ajuste local do desenvolvedor.
#
#   COMPOSE_EXTRA_PROFILES=www
_extra_profiles=()
_load_extra_profiles() {
  [[ -n "${COMPOSE_EXTRA_PROFILES:-}" ]] || return 0
  local IFS=','
  for _p in $COMPOSE_EXTRA_PROFILES; do
    [[ -n "$_p" ]] && _extra_profiles+=(--profile "$_p")
  done
}

# Detecta docker compose v2 ou cai em docker-compose v1
if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  DC=(docker-compose)
else
  print_error "Nem 'docker compose' (v2) nem 'docker-compose' (v1) encontrado"
  exit 1
fi

# Verifica daemon
if ! docker info >/dev/null 2>&1; then
  print_error "Docker não está rodando. Inicie o Docker e tente novamente."
  exit 1
fi

# Carrega o env do ambiente.
#
# `./deploy-run dev` lê .env.dev — é o arquivo local de cada desenvolvedor.
# Sem argumento, lê .env: é como a VM roda a si mesma, com o arquivo que o
# deploy-sync entregou decriptado.
ENV_SOURCE="${ENV_FILE_LOCAL:-.env}"
if [[ ! -f "$ENV_SOURCE" ]]; then
  print_error "Arquivo ${ENV_SOURCE} não encontrado!"
  exit 1
fi

set -o allexport
source "$ENV_SOURCE"
set +o allexport

_load_extra_profiles

# ─── REMOTE_BASE_PATH é relativo ao DAEMON, não a esta máquina ────────────────
#
# Os bind mounts do compose resolvem no filesystem de quem roda os containers.
# Com um contexto Docker remoto (ssh://) isso é o caminho na VM — que é o valor
# guardado no .env. Com um daemon local, é o diretório do projeto AQUI.
#
# Sem este ajuste, `docker compose up` num contexto local tentaria montar o
# caminho da VM, que não existe: os containers sobem com volumes vazios e o
# sintoma aparece longe da causa.
#
# É isto que faz `./deploy-run dev` funcionar nos dois mundos sem configuração.
DOCKER_IS_LOCAL=false
DOCKER_SSH_TARGET=""
_docker_endpoint="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)"
case "$_docker_endpoint" in
  unix://*|npipe://*)
    DOCKER_IS_LOCAL=true
    REMOTE_BASE_PATH="$PWD"
    export REMOTE_BASE_PATH
    ;;
  # Guardado para a checagem dos binds: quem manda no filesystem dos bind mounts
  # é a máquina do DAEMON, e o contexto é a autoridade sobre qual é ela.
  ssh://*)
    DOCKER_SSH_TARGET="${_docker_endpoint#ssh://}"
    ;;
esac

# ─── Sync automático: só em dev, só com daemon remoto ────────────────────────
#
# Com daemon remoto, os bind mounts leem o filesystem da VM — e o compose, o
# nginx e os envs deste projeto só chegam lá pelo deploy-sync. Mexer no compose
# e esquecer de sincronizar deixa o container subindo com a configuração velha,
# um sintoma que não aponta para a causa.
#
# É barato: o .rsyncignore exclui code/, então isto transfere só a configuração.
# O código dos apps é problema do Mutagen, que é contínuo.
#
# ⚠️ prd e stg NÃO passam por aqui de propósito. `./deploy-run prd env-app` é
#    "reinicie este serviço" — se sincronizasse, um comando de reinício passaria
#    a publicar arquivos em produção, inclusive alterações em andamento. Quem
#    quer os dois juntos usa `deploy prd`, que já encadeia sync → run.
if [[ "${ENV_TARGET:-}" == "dev" && "$DOCKER_IS_LOCAL" == false && "$NO_SYNC" == false ]]; then
  _sync_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
      local d; d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
      [[ "$src" != /* ]] && src="${d}/${src}"
    done
    cd -P "$(dirname "$src")" && pwd
  }
  _sync_bin="$(_sync_dir)/deploy-sync"
  if [[ -x "$_sync_bin" ]]; then
    print_info "Daemon remoto — sincronizando a configuração antes de subir (--no-sync pula)..."
    "$_sync_bin" dev -r || { print_error "Falha ao sincronizar"; exit 1; }
  else
    print_warning "deploy-sync não encontrado ao lado — seguindo sem sincronizar."
  fi
fi

# Valida variáveis obrigatórias
if [[ -z "${APP_ENV:-}" || -z "${APP_PROJECT_NAME:-}" ]]; then
  print_error "APP_ENV ou APP_PROJECT_NAME não definidos no .env"
  exit 1
fi
# Nome do projeto e compose file por ambiente
case "$APP_ENV" in
  development) PROJECT_NAME="${APP_PROJECT_NAME}-dev" ;;
  staging)     PROJECT_NAME="${APP_PROJECT_NAME}-stg" ;;
  production)  PROJECT_NAME="${APP_PROJECT_NAME}-prod" ;;
  *) print_error "APP_ENV inválido. Use: development, staging ou production."; exit 1 ;;
esac

if [[ "$APP_ENV" = "production" ]]; then
  if [[ -f "docker-compose.prd.yml" ]]; then
    FILES=(-f docker-compose.prd.yml)
  elif [[ -f "docker-compose.prod.yml" ]]; then
    FILES=(-f docker-compose.prod.yml)
  else
    print_error "Nenhum arquivo docker-compose de produção encontrado (prd.yml ou prod.yml)"
    exit 1
  fi
elif [[ "$APP_ENV" = "staging" ]]; then
  FILES=(-f docker-compose.stg.yml)
else
  FILES=(-f docker-compose.dev.yml)
fi

# Autenticação no registry
#
# Só é exigida quando o compose do ambiente referencia de fato uma imagem de
# registry privado (host com ponto antes da primeira barra — ex.: ghcr.io/...).
# Ambiente que só usa imagens públicas do Docker Hub (ex.: minha-conta/php-8-3,
# mariadb, redis — sem host no nome) não precisa de credencial nenhuma pra dar
# pull; antes disso o script morria aqui mesmo sem nunca tocar um registry
# privado (era o caso do dev deste projeto).
#
# Compatível com os dois modelos:
#   - Projetos novos definem REGISTRY_HOST/REGISTRY_USER/REGISTRY_TOKEN
#     (ex.: ghcr.io + PAT fine-grained só de read:packages).
#   - Projetos antigos seguem com DOCKER_USER/DOCKER_TOKEN no Docker Hub.
REGISTRY_HOST="${REGISTRY_HOST:-docker.io}"
REGISTRY_USER="${REGISTRY_USER:-${DOCKER_USER:-}}"
REGISTRY_TOKEN="${REGISTRY_TOKEN:-${DOCKER_TOKEN:-}}"

_COMPOSE_FILE_REGISTRY="${FILES[1]:-}"
NEEDS_REGISTRY_AUTH=false
if [[ -n "$_COMPOSE_FILE_REGISTRY" && -f "$_COMPOSE_FILE_REGISTRY" ]] \
   && grep -qE '^[[:space:]]*image:[[:space:]]*[A-Za-z0-9.-]+\.[A-Za-z0-9-]+(:[0-9]+)?/' "$_COMPOSE_FILE_REGISTRY"; then
  NEEDS_REGISTRY_AUTH=true
fi

if [[ "$NEEDS_REGISTRY_AUTH" == false ]]; then
  print_info "Compose de ${APP_ENV} não referencia registry privado — pulando login"
else
  if [[ -z "${REGISTRY_TOKEN}" || -z "${REGISTRY_USER}" ]]; then
    print_error "Credenciais de registry ausentes no .env"
    print_error "Defina REGISTRY_USER/REGISTRY_TOKEN (ou DOCKER_USER/DOCKER_TOKEN)"
    exit 1
  fi

  print_info "Autenticando em ${REGISTRY_HOST}..."
  # ⚠️ Sem este tratamento, o `set -e` mata o script AQUI — antes de gerar o
  #    config.json do Watchtower, lá embaixo. O container sobe com o bind mount
  #    apontando para um arquivo que não existe (o Docker cria um diretório no
  #    lugar) e o sintoma aparece só no log do Watchtower, como
  #    `auth: "not present"`, sem nenhuma menção a login.
  if ! printf '%s\n' "$REGISTRY_TOKEN" | docker login "${REGISTRY_HOST}" --username "$REGISTRY_USER" --password-stdin; then
    print_error "Login em ${REGISTRY_HOST} recusado para o usuário '${REGISTRY_USER}'."
    print_error "  O REGISTRY_TOKEN do .env.${ENV_TARGET:-prd} está inválido ou revogado."
    print_error "  Ele precisa de 'read:packages'. Corrija com: ./envedit"
    exit 1
  fi
fi

# Redes externas (idempotente)
#
# ⚠️ As duas saídas precisam ir para /dev/null. O `network inspect --format
#    {{.Id}}` IMPRIME o id quando a rede existe, e o `network create` imprime o
#    id da que criou — então cada execução deixava dois hashes soltos no stdout,
#    sem nenhum rótulo. Passava despercebido no meio da saída do compose, mas
#    aparecia como lixo em qualquer comando de saída curta (foi o `status` que
#    revelou) e poluiria o stdout de quem redirecionasse.
for network in external shared; do
  docker network inspect "$network" >/dev/null 2>&1 || \
    docker network create --driver bridge "$network" \
      --label "com.docker.compose.network=$network" >/dev/null
done

# Configuração do Watchtower (credencial de LEITURA do registry)
#
# Só existe em projetos da trilha antiga, onde o Watchtower observa a tag :prd.
# Na trilha Coolify não há Watchtower — o deploy é o webhook do painel — e este
# diretório simplesmente não existe. Antes disso o script morria aqui, num
# projeto que nunca teve nem precisaria ter Watchtower.
if [[ -f .docker/Watchtower/config.template.json ]]; then
  rm -f .docker/Watchtower/config.json
  REGISTRY_TOKEN_BASE64=$(echo -n "$REGISTRY_USER:$REGISTRY_TOKEN" | base64)
  DOCKER_TOKEN_BASE64="$REGISTRY_TOKEN_BASE64"   # nome antigo, mantido para templates legados
  export REGISTRY_TOKEN_BASE64 DOCKER_TOKEN_BASE64
  envsubst < .docker/Watchtower/config.template.json > .docker/Watchtower/config.json
  chmod 600 .docker/Watchtower/config.json
fi

################################################################################

# ⚠️ Guarda contra o modo de falha mais traiçoeiro deste setup: bind mount cuja
#    ORIGEM não existe não dá erro. O compose traz `create_host_path: true`, então
#    o Docker cria um DIRETÓRIO VAZIO no lugar. O container sobe, e o que falha é
#    outra coisa, depois: o Laravel não acha o .env, o nginx devolve 404, o
#    php-fpm não acha o index. Nada no erro aponta para "a origem não existia".
#
#    Duas causas comuns, e a mensagem tem de distinguir:
#      • .envs/*.env ausente  → rodou ./deploy-run direto, sem o ./deploy que decripta
#      • code/* ausente       → o Mutagen não está sincronizando com a VM
#
# ⚠️ A checagem tem de ser feita na máquina do DAEMON. A versão anterior trocava
#    ${REMOTE_BASE_PATH} por "." e conferia o filesystem LOCAL — com daemon
#    remoto ela olhava o Mac e dava tudo certo enquanto a VM estava vazia.
_COMPOSE_FILE="${FILES[1]:-}"
if [[ -n "$_COMPOSE_FILE" && -f "$_COMPOSE_FILE" && "$CMD" != "stop" && "$CMD" != "status" ]]; then
  _BINDS=()
  while IFS= read -r _rel; do
    [[ -n "$_rel" ]] && _BINDS+=("$_rel")
  done < <(grep -oE '\$\{REMOTE_BASE_PATH\}/[^:"'"'"'[:space:]]+' "$_COMPOSE_FILE" 2>/dev/null \
           | sed 's|\${REMOTE_BASE_PATH}/||' | sort -u)

  MISSING=()
  if [[ ${#_BINDS[@]} -gt 0 ]]; then
    if $DOCKER_IS_LOCAL; then
      for _rel in "${_BINDS[@]}"; do
        [[ -e "./${_rel}" ]] || MISSING+=("$_rel")
      done
    else
      # Um único SSH, com os caminhos entrando por stdin: sem laço de conexões e
      # sem quoting aninhado. Se o SSH não der, a checagem é PULADA — ela é uma
      # rede de proteção, não pode virar um novo motivo de falha.
      _ssh_target="${DOCKER_SSH_TARGET:-$(_read REMOTE_HOST 2>/dev/null || true)}"
      if [[ -n "$_ssh_target" ]]; then
        while IFS= read -r _rel; do
          [[ -n "$_rel" ]] && MISSING+=("$_rel")
        done < <(printf '%s\n' "${_BINDS[@]}" | ssh -o ConnectTimeout=10 -o BatchMode=yes \
                   "$_ssh_target" "cd '${REMOTE_BASE_PATH}' 2>/dev/null || exit 0
                    while IFS= read -r p; do [ -e \"\$p\" ] || printf '%s\\n' \"\$p\"; done" 2>/dev/null || true)
      fi
    fi
  fi

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    _onde="nesta máquina"; $DOCKER_IS_LOCAL || _onde="na VM (${REMOTE_BASE_PATH})"
    print_error "Origens de bind mount que não existem ${_onde}:"
    printf '    %s\n' "${MISSING[@]}" >&2
    echo >&2
    print_error "O Docker criaria um diretório VAZIO no lugar de cada uma, o container"
    print_error "subiria, e o erro apareceria depois, sem relação com a causa."
    echo >&2
    # Causa provável, pelo prefixo do que faltou.
    if printf '%s\n' "${MISSING[@]}" | grep -q '^code/'; then
      print_warning "Faltou código de app em code/ — é o sintoma de Mutagen parado."
      print_info    "  Confira a sessão:   mutagen sync list"
      print_info    "  Ou inicie no app:   cd code/<app> && mutagen project start"
    fi
    if printf '%s\n' "${MISSING[@]}" | grep -q '^\.envs/'; then
      print_warning "Faltou env de ambiente — o ./deploy-run não decripta envs."
      print_info    "  Use:  ./deploy ${ENV_TARGET:-prd}"
    fi
    exit 1
  fi
fi

if [[ "$CMD" == "--fresh" || "$CMD" == "-f" ]]; then
  print_error "ATENÇÃO: Isso vai remover TODOS os containers e volumes do projeto '${PROJECT_NAME}'."
  read -r -p "Tem certeza? [y/N]: " CONFIRM
  if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    print_warning "Operação cancelada."
    exit 0
  fi
  print_warning "Removendo containers e volumes do ambiente: ${APP_ENV}..."
  "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" down -v --remove-orphans
  print_info "Tudo removido. Recriando do zero..."
  "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" config
  [[ "$NO_PULL" == false ]] && "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" pull
  "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" up -d --remove-orphans --force-recreate --build
  print_success "Ambiente recriado com sucesso!"
  docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep "$PROJECT_NAME" || true
  exit 0
fi

# ⚠️ Este bloco tem que vir ANTES do branch de serviço, mais abaixo: lá qualquer
#    palavra não reconhecida é tratada como NOME DE SERVIÇO para reconstruir, e
#    um `./deploy-run dev status` tentaria rebuildar um serviço "status" — com um
#    erro do compose que não sugere "esse comando não existe".
if [[ "$CMD" == "status" ]]; then
  _dc_ps() {
    "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} \
      "${FILES[@]}" -p "$PROJECT_NAME" ps "$@"
  }
  # `grep -c` imprime 0 e SAI COM 1 quando não casa nada. O `|| true` engole só
  # o código de saída; um `|| echo 0` aqui imprimiria dois zeros.
  _no_ar="$(_dc_ps -q 2>/dev/null | grep -c . || true)"
  if [[ "${_no_ar:-0}" -eq 0 ]]; then
    print_warning "Nenhum container deste projeto está no ar."
    print_info "Para subir:  ./deploy-run ${ENV_TARGET:-dev}"
    exit 0
  fi
  # O `--format table` não existe em todo compose v2; o ps cru é o fallback.
  _dc_ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || _dc_ps
  exit 0
fi

if [[ "$CMD" == "stop" ]]; then
  print_info "Parando containers do ambiente: ${APP_ENV}..."
  "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" down
  print_success "Containers parados com sucesso."
  exit 0
fi

if [[ -n "$CMD" ]]; then
  print_info "Reiniciando serviço: ${CMD}..."
  [[ "$NO_PULL" == false ]] && "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" pull "$CMD"
  "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" up -d --build --force-recreate "$CMD"
  exit 0
fi

print_info "Subindo ambiente ${APP_ENV}..."
"${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" config
[[ "$NO_PULL" == false ]] && "${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" pull
"${DC[@]}" --profile "$APP_ENV" ${_extra_profiles[@]+"${_extra_profiles[@]}"} "${FILES[@]}" -p "$PROJECT_NAME" up -d --remove-orphans --force-recreate --build

print_success "Ambiente iniciado com sucesso!"
echo -e "${BLUE}Containers em execução:${NC}"
docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep "$PROJECT_NAME" || true
