#!/usr/bin/env bash
set -euo pipefail

################################################################################
# Script de Backup por Container (execução local)
# Conecta ao servidor remoto e faz backup de cada container do projeto.
#
# Modos de saída:
#   --local  (padrão)  Transfere os backups para esta máquina
#   --remote           Salva os backups no servidor (REMOTE_BASE_PATH/backups/)
#
# Lê conexão SSH de .env.AMBIENTE (igual ao deploy-sync).
################################################################################

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

ENV_TARGET=""
SERVER_FILTER=""
SSH_KEY=${SSH_KEY:-}
BASTION_HOST=""
REMOTE_HOST=""
REMOTE_HOST_OVERRIDE=""
REMOTE_BASE_PATH=""
PROJECT_NAME=""

BACKUP_DEST="local"
BACKUP_BASE_DIR="${BACKUP_DIR:-./backups}"
BACKUP_RETENTION="${BACKUP_RETENTION:-7}"
COMPRESS=true
DRY_RUN=false
SKIP_GENERIC=false
SSH_CONTROL_SOCKET=""

################################################################################
# Utilidade
################################################################################

print_error()   { echo -e "${RED}[ERRO]${NC} $*" >&2; }
print_success() { echo -e "${GREEN}[OK]${NC} $*"; }
print_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
print_warning() { echo -e "${YELLOW}[AVISO]${NC} $*"; }
print_header()  { echo -e "\n${BLUE}===${NC} $* ${BLUE}===${NC}"; }
print_step()    { echo -e "${CYAN}[>>]${NC} $*"; }

_local_env_read() {
  local key="$1" file="$2"
  grep "^${key}=" "$file" | cut -d= -f2- | tr -d '"' | tr -d "'" || true
}

_remote_env_read() {
  local ssh_cmd="$1" key="$2"
  $ssh_cmd "$REMOTE_HOST" \
    "grep '^${key}=' '${REMOTE_BASE_PATH}/.env' | cut -d= -f2- | tr -d '\"' | tr -d \"'\"" \
    2>/dev/null || true
}

_remote_container_env() {
  local ssh_cmd="$1" container="$2" var="$3"
  $ssh_cmd "$REMOTE_HOST" "docker exec '${container}' printenv '${var}' 2>/dev/null || true"
}

_filesize() {
  [[ -e "$1" ]] && du -sh "$1" | cut -f1 || echo "?"
}

_cleanup_ssh() {
  if [[ -n "$SSH_CONTROL_SOCKET" ]]; then
    ssh -O exit -o "ControlPath=${SSH_CONTROL_SOCKET}" placeholder 2>/dev/null || true
    rm -f "$SSH_CONTROL_SOCKET"
  fi
}
trap _cleanup_ssh EXIT INT TERM

################################################################################
# Ajuda e argumentos
################################################################################

show_usage() {
  cat << EOF
Uso: $(basename "$0") [AMBIENTE] [SERVIDOR] [OPÇÕES]

Conecta ao servidor(es) remoto(s) e faz backup de cada container.
Com servers.yml: itera por todos os servidores do ambiente (ou um específico).
Sem servers.yml: lê conexão de .env.AMBIENTE (servidor único).

AMBIENTE:
  dev, prd, stg    Ambiente alvo

SERVIDOR:
  <nome>           (opcional) Nome do servidor em servers.yml.
                   Omitir = todos os servidores do ambiente.

DESTINO:
  --local,  -L     Transfere backup para esta máquina (padrão)
  --remote, -R     Salva backup no servidor (REMOTE_BASE_PATH/backups/)

OPÇÕES:
  --no-compress,-C   Não comprime os arquivos gerados
  --no-generic, -G   Pula containers sem banco de dados detectado
  --dry-run,    -n   Simula sem executar nada
  --retain N,   -k N Mantém os N backups mais recentes (padrão: 7)
  --dir DIR,    -o DIR Diretório local de saída (padrão: ./backups)
  --help,       -h   Exibe esta ajuda

EXEMPLOS (com servers.yml):
  ./deploy-backup prd              Backup de todos os servidores PRD
  ./deploy-backup prd redis        Só o servidor 'redis'
  ./deploy-backup prd -n           Dry-run de todos os PRD
  ./deploy-backup prd main --remote  Backup do main salvo no servidor

SAÍDA LOCAL (./backups/prd/YYYY-MM-DD_HH-MM-SS/[SERVIDOR/]<container>/):
  dump.sql.gz      MySQL ou PostgreSQL
  dump.rdb         Redis
  mongodump.tar.gz MongoDB
  volumes/         Containers genéricos (volumes nomeados)

ARQUIVO servers.yml (no diretório do projeto):
  servers:
    prd:
      - name: main
        label: VM Principal
        env_file: .env.prd
      - name: redis
        label: VM Redis
        env_file: .docker-stand-alone/Database/Redis/.env.prd

  Sem servers.yml: lê .env.AMBIENTE do diretório atual (comportamento original).

EOF
}

parse_arguments() {
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
      show_usage; exit 0
    fi
  done

  if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
    ENV_TARGET="$1"; shift
  fi

  # Segundo posicional opcional: SERVIDOR
  if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
    SERVER_FILTER="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local|-L)       BACKUP_DEST="local" ;;
      --remote|-R)      BACKUP_DEST="remote" ;;
      --no-compress|-C) COMPRESS=false ;;
      --no-generic|-G)  SKIP_GENERIC=true ;;
      --dry-run|-n)     DRY_RUN=true ;;
      --retain|-k)      shift; BACKUP_RETENTION="${1:?'--retain requer N'}" ;;
      --dir|-o)         shift; BACKUP_BASE_DIR="${1:?'--dir requer caminho'}" ;;
      *) print_error "Opção desconhecida: $1"; show_usage; exit 1 ;;
    esac
    shift
  done

  if [[ -z "$ENV_TARGET" ]]; then
    print_error "Ambiente obrigatório: dev, prd ou stg"
    show_usage; exit 1
  fi
}

