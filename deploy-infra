#!/usr/bin/env bash
set -uo pipefail

################################################################################
# deploy-infra — sobe a infra de desenvolvimento compartilhada
#
# Cria a rede `shared` e os serviços que todo projeto espera achar nela:
# Traefik (roteamento), MariaDB, Redis e Mailpit.
#
# Sobe UMA vez por máquina — ou por contexto Docker, que dá no mesmo: o comando
# respeita o contexto ativo. Contexto local sobe na sua máquina; um contexto
# ssh:// sobe na VM. Os projetos não mudam nada por causa disso.
#
# Uso:  ./deploy-infra <comando> [--context NOME]
#   up        cria a rede e sobe os serviços
#   createdb  cria database + usuário + senha para um projeto
#   down      derruba, PRESERVANDO os volumes (os dados ficam)
#   status    o que está no ar e em qual contexto
#   logs      acompanha os logs
#   reset     derruba E APAGA os volumes — o banco volta do zero
#
# Uso do createdb:  ./deploy-infra createdb <nome> [--print-env] [--password P]
#   Cria o database, um usuário homônimo e o grant. Sem --password, gera uma.
#   Com --print-env, imprime só as 4 linhas prontas para o .env do app.
#
# Uso do reset:     ./deploy-infra reset [--force]
#   --force pula a confirmação — só para quem já confirmou antes.
################################################################################

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'
print_error()   { echo -e "${RED}[ERRO]${NC} $*" >&2; }
print_success() { echo -e "${GREEN}[OK]${NC} $*"; }
print_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
print_warning() { echo -e "${YELLOW}[AVISO]${NC} $*"; }

CMD="${1:-}"; shift 2>/dev/null || true
CONTEXT=""; DB_NAME=""; DB_PASS=""; PRINT_ENV=false; FORCE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --context)    CONTEXT="$2"; shift 2 ;;
    --password)   DB_PASS="$2"; shift 2 ;;
    --print-env)  PRINT_ENV=true; shift ;;
    --force)      FORCE=true; shift ;;
    -*) print_error "Opção desconhecida: $1"; exit 2 ;;
    *)  DB_NAME="$1"; shift ;;
  esac
done
case "$CMD" in
  -h|--help|'') sed -n '5,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  up|down|status|logs|reset|createdb) ;;
  *) print_error "Comando inválido: ${CMD}"; echo "Use: up | createdb | down | status | logs | reset" >&2; exit 2 ;;
esac

_scripts_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local d; d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="${d}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}
DIR="$(_scripts_dir)/infra"
[[ -f "$DIR/docker-compose.yml" ]] || { print_error "Compose não encontrado: $DIR"; exit 1; }

command -v docker >/dev/null 2>&1 || { print_error "docker não encontrado"; exit 1; }
# ⚠️ --env-file é obrigatório: o docker compose lê `.env` por convenção, e o
#    arquivo aqui chama-se .env.dev. Sem isto a interpolação falha com
#    "required variable MYSQL_ROOT_PASSWORD is missing a value" — mesmo com o
#    valor preenchido no arquivo certo.
DC=(docker compose --env-file .env.dev)
docker compose version >/dev/null 2>&1 || DC=(docker-compose --env-file .env.dev)
[[ -n "$CONTEXT" ]] && DC=(docker --context "$CONTEXT" compose --env-file .env.dev)

# ─── Onde isto vai rodar ─────────────────────────────────────────────────────
#
# O contexto decide o destino, e o dev PRECISA ver isso antes de qualquer ação:
# subir a infra na VM errada é fácil e confuso de diagnosticar.
ctx_name="${CONTEXT:-$(docker context show 2>/dev/null || echo default)}"
ctx_host="$(docker context inspect "$ctx_name" --format '{{.Endpoints.docker.Host}}' 2>/dev/null || echo '?')"
case "$ctx_host" in
  unix://*|npipe://*) ctx_kind="${GREEN}LOCAL${NC}" ;;
  ssh://*|tcp://*)    ctx_kind="${YELLOW}REMOTO${NC}" ;;
  *)                  ctx_kind="?" ;;
esac
# ⚠️ Com --print-env a saída é DADO, não relatório: ela é redirecionada para um
#    arquivo que o deploy-scaffold-project lê. Qualquer linha informativa aqui
#    corromperia esse arquivo — por isso o cabeçalho é suprimido.
if ! $PRINT_ENV; then
  echo -e "${BOLD}Contexto${NC}  ${ctx_name}  (${ctx_kind}) — ${ctx_host}"
  echo
fi

ENV_FILE="$DIR/.env.dev"
_require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$DIR/.env.dev.example" "$ENV_FILE"
    print_warning "Criei ${ENV_FILE} a partir do template."
    print_error   "Preencha MYSQL_ROOT_PASSWORD e REDIS_PASSWORD antes de subir."
    exit 1
  fi
  # ⚠️ Tira as aspas antes de julgar: KEY="" tem conteúdo para o grep, mas é
  #    valor vazio. Sem isto o guard deixa passar um template não preenchido.
  local faltando=() v
  for k in MYSQL_ROOT_PASSWORD REDIS_PASSWORD; do
    v="$(grep -E "^${k}=" "$ENV_FILE" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true)"
    [[ -n "$v" ]] || faltando+=("$k")
  done
  if [[ ${#faltando[@]} -gt 0 ]]; then
    print_error "Sem valor em ${ENV_FILE}: ${faltando[*]}"
    print_info  "São senhas locais suas — invente e preencha."
    exit 1
  fi
}

cd "$DIR" || exit 1
case "$CMD" in
  up)
    _require_env
    print_info "Subindo a infra..."
    "${DC[@]}" up -d --remove-orphans || { print_error "Falha ao subir"; exit 1; }
    echo
    "${DC[@]}" ps --format 'table {{.Name}}\t{{.Status}}' 2>/dev/null || "${DC[@]}" ps
    echo
    print_success "Rede 'shared' criada e infra no ar."
    src_port=$(grep -E '^TRAEFIK_DASHBOARD_PORT=' "$ENV_FILE" | cut -d= -f2); src_port="${src_port:-8080}"
    mail_port=$(grep -E '^MAILPIT_WEB_PORT=' "$ENV_FILE" | cut -d= -f2); mail_port="${mail_port:-8025}"
    print_info "Traefik:  http://127.0.0.1:${src_port}   (dashboard, só loopback)"
    print_info "Mailpit:  http://127.0.0.1:${mail_port}"
    if [[ -z "${DEPLOY_WIZARD:-}" ]]; then
      echo
      echo "${BOLD}Próximo passo${NC} — criar o banco do seu produto:"
      echo "  deploy-infra createdb <nome> --print-env > /tmp/<nome>-db.env"
    fi
    ;;
  down)
    print_info "Derrubando (os volumes ficam)..."
    "${DC[@]}" down && print_success "Infra parada. Os dados foram preservados."
    ;;
  status)
    "${DC[@]}" ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || "${DC[@]}" ps
    echo
    if docker network inspect shared >/dev/null 2>&1; then
      print_success "Rede 'shared' existe."
    else
      print_warning "Rede 'shared' NÃO existe — rode: deploy-infra up"
    fi
    ;;
  createdb)
    _require_env
    if [[ -z "$DB_NAME" ]]; then
      print_error "Falta o nome: ./deploy-infra createdb <nome>"; exit 2
    fi
    # Nome vira identificador SQL — restringe para não precisar escapar nada.
    if [[ ! "$DB_NAME" =~ ^[a-z][a-z0-9_]{0,30}$ ]]; then
      print_error "Nome inválido: '${DB_NAME}'"
      print_info  "Use minúsculas, números e _, começando por letra (até 31 chars)."
      exit 2
    fi
    # Tira as aspas: o template usa KEY="valor" por convenção, e sem remover
    # as aspas a senha vai com elas para o MySQL e a autenticação falha — com
    # uma mensagem que culpa a credencial, e ela parece certa no arquivo.
    root_pass="$(grep -E '^MYSQL_ROOT_PASSWORD=' "$ENV_FILE" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
    [[ -z "$DB_PASS" ]] && DB_PASS="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)"

    if ! docker ${CONTEXT:+--context "$CONTEXT"} ps --filter 'name=^infra-mysql$' --format '{{.Names}}' 2>/dev/null | grep -q infra-mysql; then
      print_error "O container infra-mysql não está no ar."
      print_info  "Rode antes: deploy-infra up"
      exit 1
    fi

    # ⚠️ O `up` volta assim que os containers iniciam, mas o MySQL leva alguns
    #    segundos para aceitar conexão. Quem seguisse o passo a passo direto
    #    batia num "Falha ao criar o database" que culpava a senha — a senha
    #    estava certa, o banco é que não estava pronto. Esperar aqui é melhor do
    #    que pedir ao usuário que espere.
    _mysql_health() {
      docker ${CONTEXT:+--context "$CONTEXT"} inspect \
        --format '{{.State.Health.Status}}' infra-mysql 2>/dev/null
    }
    if [[ "$(_mysql_health)" != "healthy" ]]; then
      # >&2 é obrigatório: com --print-env o stdout é um arquivo de dados, e
      # qualquer linha informativa aqui vira lixo que o consumidor tenta parsear.
      print_info "Aguardando o MySQL aceitar conexão..." >&2
      for _i in $(seq 1 60); do
        [[ "$(_mysql_health)" == "healthy" ]] && break
        sleep 2
      done
      if [[ "$(_mysql_health)" != "healthy" ]]; then
        print_error "O infra-mysql não ficou saudável em 120s."
        print_info  "Veja o que houve: deploy-infra logs"
        exit 1
      fi
    fi

    # O SQL entra por stdin: a senha nunca aparece na linha de comando do container
    # (visível em `docker inspect` e no histórico do shell).
    sql="CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_NAME}'@'%' IDENTIFIED BY '${DB_PASS}';
ALTER USER '${DB_NAME}'@'%' IDENTIFIED BY '${DB_PASS}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_NAME}'@'%';
FLUSH PRIVILEGES;"
    # `2>&1 >/dev/null` (nesta ordem) captura SÓ o stderr: manda o stderr para a
    # captura e depois joga o stdout fora. Sem isto o erro do MySQL ia para
    # /dev/null e sobrava um "falhou" sem motivo.
    if ! erro_sql="$(printf '%s\n' "$sql" | docker ${CONTEXT:+--context "$CONTEXT"} exec -i \
         -e MYSQL_PWD="$root_pass" infra-mysql mariadb -uroot 2>&1 >/dev/null)"; then
      # ⚠️ MASCARAR antes de imprimir. Um erro de sintaxe faz o cliente ecoar o
      #    trecho do SQL — e o CREATE USER carrega a senha em texto puro.
      [[ -n "$DB_PASS"   ]] && erro_sql="${erro_sql//$DB_PASS/***}"
      [[ -n "$root_pass" ]] && erro_sql="${erro_sql//$root_pass/***}"

      print_error "Falha ao criar o database '${DB_NAME}'."
      [[ -n "$erro_sql" ]] && print_error "MySQL disse: $(printf '%s' "$erro_sql" | head -2 | tr '\n' ' ')"

      # ⚠️ >&2 obrigatório. Com --print-env o stdout é ARQUIVO DE DADOS: sem isto
      #    estas quatro dicas caem dentro dele e a pessoa vê só "Falha ao criar",
      #    justamente quando mais precisa saber o motivo.
      print_info  "O MySQL está saudável, então o mais provável é a credencial:" >&2
      print_info  "  confira MYSQL_ROOT_PASSWORD em ${ENV_FILE}." >&2
      print_info  "A senha do volume é a do PRIMEIRO boot. Se o arquivo mudou depois" >&2
      print_info  "(ex.: você reclonou a biblioteca), elas divergiram. Saídas:" >&2
      print_info  "  • recuperar a senha antiga e colocá-la no arquivo, ou" >&2
      print_info  "  • deploy-infra reset  — recria o volume e APAGA os dados." >&2
      exit 1
    fi

    if $PRINT_ENV; then
      # Só as 4 linhas — pensado para redirecionar num arquivo.
      printf 'DB_HOST=infra-mysql\nDB_DATABASE=%s\nDB_USERNAME=%s\nDB_PASSWORD=%s\n' \
             "$DB_NAME" "$DB_NAME" "$DB_PASS"
      exit 0
    fi
    print_success "Database '${DB_NAME}' e usuário criados."
    echo
    echo "Cole no .env do app:"
    echo "  DB_HOST=infra-mysql"
    echo "  DB_DATABASE=${DB_NAME}"
    echo "  DB_USERNAME=${DB_NAME}"
    echo "  DB_PASSWORD=${DB_PASS}"
    echo
    if [[ -z "${DEPLOY_WIZARD:-}" ]]; then
      print_info "Próximo passo: gerar o projeto com"
      print_info "  deploy-scaffold-project <dominio> --from-kit <caminho> --apply"
    fi
    ;;
  logs) "${DC[@]}" logs -f --tail=100 ;;
  reset)
    print_warning "Isto APAGA os volumes: banco, cache e e-mails locais somem."
    # --force existe para quem JÁ confirmou noutro lugar (o assistente pergunta
    # com o que será perdido escrito na tela). Pedir de novo logo em seguida
    # treina a pessoa a digitar 'apagar' no reflexo, que é o oposto do objetivo.
    if ! $FORCE; then
      read -r -p "Digite 'apagar' para confirmar: " ok
      [[ "$ok" == "apagar" ]] || { print_info "Cancelado."; exit 0; }
    fi
    "${DC[@]}" down -v && print_success "Infra derrubada e volumes apagados."
    ;;
esac
