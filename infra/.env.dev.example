# Infra de desenvolvimento — copie para .env.dev e preencha.
# Este arquivo é um template: os valores sensíveis nascem VAZIOS de propósito.
# Cada dev usa as próprias senhas locais; nada aqui é compartilhado.

# ─── Credenciais locais ──────────────────────────────────────────────────────
#
# ⚠️ Não invente à mão. Senha curta de teclado ("1q2w3e") vira senha permanente,
#    e este banco fica exposto na sua rede local enquanto o ambiente roda.
#
# Gere uma para cada linha abaixo:
#
#     openssl rand -hex 24
#
# Sem openssl, use:  head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
#
MYSQL_ROOT_PASSWORD=""
REDIS_PASSWORD=""

# ─── Portas no host ──────────────────────────────────────────────────────────
# A 80 é a única publicada em 0.0.0.0 — as demais ficam no loopback.
# Troque se algo já ocupa a porta na sua máquina.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ─── Serviços opcionais ──────────────────────────────────────────────────────
#
# Liste, separados por espaço, os extras que seus projetos usam:
#
#     s3       MinIO — S3 local, container infra-s3 (console em :9001)
#     search   Meilisearch — busca, container infra-meilisearch
#
# Vazio = só a base (Traefik, MariaDB, Redis, Mailpit).
INFRA_EXTRAS=""

# Obrigatórias só se o extra correspondente estiver ligado. Gere como acima.
MINIO_ROOT_USER="minio"
MINIO_ROOT_PASSWORD=""
MEILI_MASTER_KEY=""

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MEILI_PORT=7700

# ─── Ajustes ─────────────────────────────────────────────────────────────────
TZ="America/Sao_Paulo"
MYSQL_BUFFER_POOL="256M"
REDIS_MAXMEMORY="256mb"

# Arquitetura das imagens de terceiros.
#
# ⚠️ O padrão é linux/amd64 DE PROPÓSITO, mesmo em Apple Silicon: imagens de
#    terceiros já deram problemas difíceis de diagnosticar em arm64, e perder
#    desempenho é melhor do que perder dias procurando onde o erro mora.
#    Só mude se souber o que está fazendo — e reverta ao primeiro sintoma estranho.
INFRA_PLATFORM="linux/amd64"
