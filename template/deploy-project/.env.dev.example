# Ambiente
APP_ENV="development"
APP_PROJECT_NAME="__PROJECT__"
# Caminho base remoto (onde o projeto está na VM)
# Para desenvolvimento local: /caminho/atual
BASTION_HOST=""
REMOTE_HOST="root@vm-docker-code"
REMOTE_BASE_PATH="/home/SEU_USUARIO/projetos/deploy.__DOMAIN__"
# Permite sincronizar arquivos do host para o container após o build
SYNC_POST_RUN=false
# Permissões (UID/GID do usuário que roda Docker)
# Para descobrir: id -u (UID) e id -g (GID)
APP_UID=501 # 1000
APP_GID=501 # 1000
# Log e Scheduler
LOG_LEVEL="INFO"
SCHEDULER_PORT=5000
# Timezone
TZ="America/Sao_Paulo"
##############################################################################
# Services
##############################################################################
# MeiliSearch (Search Engine)
MEILI_MASTER_KEY=
# Redis (Cache e Sessões)
REDIS_PASSWORD=
# MySQL (Database)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER="__PROJECT__"
MYSQL_DATABASE="api_app___PROJECT__"
# MongoDB (NoSQL Database)
MONGO_INITDB_DATABASE="admin"
MONGO_INITDB_ROOT_USERNAME="root"
MONGO_INITDB_ROOT_PASSWORD=
##############################################################################
# Traefik (Reverse Proxy) e SSL/TLS
##############################################################################
# Email para Let's Encrypt (certificados SSL)
TRAEFIK_ACME_EMAIL="voce@exemplo.com"
# Sufixo de domínio (para staging: .io, para prod: .com.br)
TRAEFIK_DOMAIN_SUFFIX="io"
##############################################################################
# Blog: WordPress
##############################################################################
BLOG_DB_HOST=""
BLOG_DB_NAME=""
BLOG_DB_USER=""      
BLOG_DB_PASSWORD=
BLOG_ADMIN_USER=""
BLOG_ADMIN_PASSWORD=
BLOG_ADMIN_EMAIL=""
WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=

# ─── Serviços opcionais ──────────────────────────────────────────────────────
# Profiles extras do docker compose, separados por vírgula. Ativam serviços que
# nascem inertes. O www do kit é um: instale o app e ponha "www" aqui.
COMPOSE_EXTRA_PROFILES=
